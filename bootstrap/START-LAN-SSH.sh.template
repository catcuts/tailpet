#!/bin/bash
# START-LAN-SSH.sh - Linux C node (LAN-only, behind B) bootstrap
# Rendered by tailpet-b.ps1 make-c-zip ({{B_PUBKEY}} = B's public key)
# Usage: sudo bash START-LAN-SSH.sh
# Idempotent: safe to re-run.

set -e

# ---- [1/3] sshd ----
echo "[1/3] OpenSSH Server..."
if ! systemctl is-active sshd &>/dev/null && ! systemctl is-active ssh &>/dev/null; then
  if command -v apt-get &>/dev/null; then
    apt-get update -qq && apt-get install -y -qq openssh-server
  elif command -v yum &>/dev/null || command -v dnf &>/dev/null; then
    yum install -y openssh-server 2>/dev/null || dnf install -y openssh-server
  fi
  systemctl enable --now sshd 2>/dev/null || systemctl enable --now ssh
fi
echo "      sshd: $(systemctl is-active sshd 2>/dev/null || systemctl is-active ssh 2>/dev/null)"

# ---- [2/3] authorize B public key ----
echo "[2/3] authorizing B public key..."
PUB='{{B_PUBKEY}}'
SSH_DIR="$HOME/.ssh"
mkdir -p "$SSH_DIR"
chmod 700 "$SSH_DIR"
touch "$SSH_DIR/authorized_keys"
chmod 600 "$SSH_DIR/authorized_keys"
KEY_BODY=$(echo "$PUB" | awk '{print $2}')
if ! grep -q "$KEY_BODY" "$SSH_DIR/authorized_keys" 2>/dev/null; then
  echo "$PUB" >> "$SSH_DIR/authorized_keys"
fi
echo "      done"

# ---- [3/3] firewall: SSH from local subnet only ----
echo "[3/3] firewall..."
if command -v ufw &>/dev/null && ufw status | grep -q "active"; then
  SUBNET=$(ip -4 route | grep -oP '^\d+\.\d+\.\d+\.\d+/\d+' | head -1)
  ufw allow from "$SUBNET" to any port 22
  echo "      ufw: allowed SSH from $SUBNET"
else
  echo "      (ufw not active; configure manually if needed)"
fi

# ---- report ----
echo ""
echo "==== LAN C setup COMPLETE ===="
hostname
echo "IP(s): $(hostname -I)"
echo "From B: ssh $(whoami)@<IP-above> (passwordless via B key)"
