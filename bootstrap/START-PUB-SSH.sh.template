#!/bin/bash
# START-PUB-SSH.sh - Linux machine with public IP (not joining tailnet)
# Rendered by tailpet gen-b --zip ({{A_PUBKEY}} = A's management public key)
# Usage: sudo bash START-PUB-SSH.sh
# Idempotent: safe to re-run.

set -e

# ---- [1/3] sshd ----
echo "[1/3] OpenSSH Server..."
if ! systemctl is-active sshd &>/dev/null && ! systemctl is-active ssh &>/dev/null; then
  if command -v apt-get &>/dev/null; then
    apt-get update -qq && apt-get install -y -qq openssh-server
  elif command -v yum &>/dev/null || command -v dnf &>/dev/null; then
    yum install -y openssh-server 2>/dev/null || dnf install -y openssh-server
  fi
  systemctl enable --now sshd 2>/dev/null || systemctl enable --now ssh
fi
echo "      sshd: $(systemctl is-active sshd 2>/dev/null || systemctl is-active ssh 2>/dev/null)"

# ---- [2/3] authorize A management key ----
echo "[2/3] authorizing A management key..."
PUB='{{A_PUBKEY}}'
SSH_DIR="$HOME/.ssh"
mkdir -p "$SSH_DIR"
chmod 700 "$SSH_DIR"
touch "$SSH_DIR/authorized_keys"
chmod 600 "$SSH_DIR/authorized_keys"
KEY_BODY=$(echo "$PUB" | awk '{print $2}')
if ! grep -q "$KEY_BODY" "$SSH_DIR/authorized_keys" 2>/dev/null; then
  echo "$PUB" >> "$SSH_DIR/authorized_keys"
fi
echo "      done"

# ---- [3/3] report ----
echo "[3/3] Report:"
hostname
whoami
PUB_IP=$(curl -s -m 5 ifconfig.me 2>/dev/null || echo "(detect failed)")
echo "Public IP: $PUB_IP"
echo ""
echo "==== Public sshd ready ===="
echo "From A: tailpet ssh <name> (add to registry first)"
