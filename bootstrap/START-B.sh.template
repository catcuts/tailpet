#!/bin/bash
# START-B.sh - Linux B node bootstrap (rendered by tailpet gen-b --zip)
# Usage: sudo bash START-B.sh
# Idempotent: safe to re-run.
# {{AUTHKEY}} expires {{EXPIRES}}

set -e

# ---- [0/5] key validity check ----
EXPIRES="{{EXPIRES}}"
if [ "$(date +%s)" -gt "$(date -d "$EXPIRES" +%s 2>/dev/null || echo 0)" ]; then
  echo "!! Enrollment key expired at $EXPIRES"
  echo "   On A: tailpet gen-b --zip, then redo with new package"
  exit 1
fi
echo "[0/5] key valid until $EXPIRES"

# ---- [1/5] install Tailscale if missing ----
TS_BIN=$(which tailscaled 2>/dev/null || echo "/usr/sbin/tailscaled")
if [ ! -x "$TS_BIN" ] && ! systemctl is-active tailscaled &>/dev/null; then
  echo "[1/5] installing Tailscale..."
  if command -v apt-get &>/dev/null; then
    curl -fsSL https://tailscale.com/install.sh | sh
  elif command -v yum &>/dev/null || command -v dnf &>/dev/null; then
    curl -fsSL https://tailscale.com/install.sh | sh
  else
    echo "!! unsupported package manager; install Tailscale manually from https://tailscale.com/download"
    exit 1
  fi
  systemctl enable --now tailscaled 2>/dev/null || true
else
  echo "[1/5] Tailscale already installed"
fi

# ---- [2/5] join tailnet ----
echo "[2/5] joining tailnet..."
tailscale up --login-server={{SERVER}} --authkey={{AUTHKEY}} \
  --hostname=$(hostname -s | tr '[:upper:]' '[:lower:]') \
  --accept-routes --accept-dns=false 2>/dev/null || true
sleep 3
IP=$(tailscale ip -4 2>/dev/null)
if [ -z "$IP" ]; then
  echo "!! join failed; check authkey validity and network"
  exit 1
fi
echo "      joined, tailscale ip: $IP"

# ---- [3/5] sshd ----
echo "[3/5] OpenSSH Server..."
if ! systemctl is-active sshd &>/dev/null && ! systemctl is-active ssh &>/dev/null; then
  if command -v apt-get &>/dev/null; then
    apt-get update -qq && apt-get install -y -qq openssh-server
  elif command -v yum &>/dev/null || command -v dnf &>/dev/null; then
    (yum or dnf) install -y openssh-server 2>/dev/null || dnf install -y openssh-server
  fi
  systemctl enable --now sshd 2>/dev/null || systemctl enable --now ssh
fi
echo "      sshd: $(systemctl is-active sshd 2>/dev/null || systemctl is-active ssh 2>/dev/null)"

# ---- [4/5] authorize A management key ----
echo "[4/5] authorizing A management key..."
PUB='{{A_PUBKEY}}'
SSH_DIR="$HOME/.ssh"
mkdir -p "$SSH_DIR"
chmod 700 "$SSH_DIR"
touch "$SSH_DIR/authorized_keys"
chmod 600 "$SSH_DIR/authorized_keys"
KEY_BODY=$(echo "$PUB" | awk '{print $2}')
if ! grep -q "$KEY_BODY" "$SSH_DIR/authorized_keys" 2>/dev/null; then
  echo "$PUB" >> "$SSH_DIR/authorized_keys"
fi
echo "      done"

# ---- [5/5] report ----
echo "[5/5] Report:"
hostname
whoami
echo "tailscale: $(tailscale status 2>/dev/null | head -3)"
echo ""
echo "==== B bootstrap COMPLETE - manage from A: tailpet ssh ===="
