# agent-v2.ps1 - tailpet V2 agent: outbound HTTP long-poll to the hub.
# PS 2.0+ compatible.
# Rendered by: tailpet agent add <name>
param([switch]$Install, [string]$Relay, [string]$RHost, [string]$RPort)

$hub = '{{HUB_URL}}'
$aid = '{{AGENT_ID}}'
$token = '{{TOKEN}}'
$name = '{{NAME}}'
$dataDir = 'C:\ProgramData\tailpet'
$taskName = 'tailpet-agent-v2-{{AGENT_ID}}'
$selfPath = $MyInvocation.MyCommand.Path

function JsonStr([string]$s) {
    $s = $s.Replace('\', '\\').Replace('"', '\"').Replace("`r", '\r').Replace("`n", '\n').Replace("`t", '\t')
    return '"' + $s + '"'
}

function HttpReq([string]$method, [string]$url, [string]$body) {
    $req = [System.Net.HttpWebRequest]::Create($url)
    $req.Method = $method
    $req.Timeout = 40000
    if ($body) {
        $req.ContentType = 'application/json'
        $bytes = [Text.Encoding]::UTF8.GetBytes($body)
        $req.ContentLength = $bytes.Length
        $s = $req.GetRequestStream()
        $s.Write($bytes, 0, $bytes.Length)
        $s.Close()
    }
    try {
        $resp = $req.GetResponse()
    } catch [System.Net.WebException] {
        $resp = $_.Exception.Response
    }
    if (-not $resp) { return '' }
    $sr = New-Object IO.StreamReader -ArgumentList @($resp.GetResponseStream(), [Text.Encoding]::UTF8)
    $txt = $sr.ReadToEnd()
    $sr.Close()
    return $txt
}

if ($Install) {
    New-Item -ItemType Directory -Force -Path $dataDir | Out-Null
    $dst = Join-Path $dataDir 'agent-v2.ps1'
    Copy-Item -Path $MyInvocation.MyCommand.Path -Destination $dst -Force
    $runner = Join-Path $dataDir 'run-agent.bat'
    # bat wrapper avoids schtasks /tr quote-escaping bugs on Server 2008 R2
    Set-Content -Path $runner -Value ('@powershell -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File "' + $dst + '"') -Encoding ascii
    # 升级接管：旧常驻实例持有互斥体，不杀则新实例被顶掉、磁盘新码永不生效
    schtasks /end /tn $taskName | Out-Null
    Get-WmiObject Win32_Process -Filter "Name='powershell.exe'" | ForEach-Object {
        $cl = [string]$_.CommandLine
        if ($cl -and $cl -notlike '*-Install*' -and ($cl -like '*agent-v2.ps1*' -or $cl -like '*agent.ps1*') -and $_.ProcessId -ne $PID) {
            taskkill /f /pid $_.ProcessId | Out-Null
        }
    }
    # /ru SYSTEM: no desktop session -> no popup windows on legacy systems
    schtasks /create /f /tn $taskName /tr $runner /sc minute /mo 1 /ru SYSTEM | Out-Null
    schtasks /run /tn $taskName | Out-Null
    # ---- bundled OpenSSH client: B acts as ssh client to its LAN C machines ----
    $sshDir = Join-Path $dataDir 'OpenSSH-Win64'
    $sshZip = Join-Path (Split-Path -Parent $MyInvocation.MyCommand.Path) 'OpenSSH-Win64.zip'
    if (-not (Test-Path $sshZip)) { $sshZip = Join-Path $dataDir 'OpenSSH-Win64.zip' }
    if (Test-Path $sshZip) {
        Write-Output 'installing bundled OpenSSH client...'
        if (-not (Test-Path (Join-Path $sshDir 'ssh.exe'))) {
            $shell = New-Object -ComObject Shell.Application
            $shell.NameSpace($dataDir).CopyHere($shell.NameSpace($sshZip).Items(), 16)
            $tries = 0
            while (-not (Test-Path (Join-Path $sshDir 'ssh.exe')) -and $tries -lt 90) { Start-Sleep -Seconds 2; $tries = $tries + 1 }
        }
        if (Test-Path (Join-Path $sshDir 'ssh.exe')) {
            $keysDir = Join-Path $dataDir 'keys'
            New-Item -ItemType Directory -Force -Path $keysDir | Out-Null
            # keys 目录立干净 ACL：SYSTEM+Administrators 可继承，杜绝 Users/CREATOR-OWNER 残留
            Start-Process icacls.exe -ArgumentList @($keysDir, '/inheritance:r', '/grant', '*S-1-5-18:(OI)(CI)F', '/grant', '*S-1-5-32-544:(OI)(CI)F') -Wait -WindowStyle Hidden
            $keyFile = Join-Path $keysDir 'id_ed25519'
            if (-not (Test-Path $keyFile)) {
                Start-Process -FilePath (Join-Path $sshDir 'ssh-keygen.exe') -ArgumentList @('-t', 'ed25519', '-f', $keyFile, '-N', '""', '-C', ('tailpet-' + $aid)) -Wait -WindowStyle Hidden
            }
            # OpenSSH 拒绝 ACL 过开的私钥：文件层兜底（并清掉显式残留）
            Start-Process icacls.exe -ArgumentList @($keyFile, '/inheritance:r', '/grant', '*S-1-5-18:F', '/grant', '*S-1-5-32-544:F') -Wait -WindowStyle Hidden
            $sshc = '@echo off' + [Environment]::NewLine + ('set "PATH=' + $sshDir + ';%PATH%"') + [Environment]::NewLine + ('"' + (Join-Path $sshDir 'ssh.exe') + '" -i "' + $keyFile + '" -o StrictHostKeyChecking=accept-new -o BatchMode=yes %*')
            Set-Content -Path (Join-Path $dataDir 'ssh-c.bat') -Value $sshc -Encoding ascii
            Write-Output 'OpenSSH client ready (ssh-c user@C-IP "cmd" -> LAN machines)'
        } else {
            Write-Output '!! OpenSSH extraction timed out'
        }
    }
    # ---- 文件传输 worker：大输出/文件经 hub 中转存储（分块+重试+状态文件）----
    New-Item -ItemType Directory -Force -Path (Join-Path $dataDir 'spool') | Out-Null
$xfer = @'
param([string]$Mode, [string]$Hub, [string]$Aid, [string]$Token, [string]$Name, [string]$Path, [string]$DataDir)
$ErrorActionPreference = 'Stop'
$StatusF = Join-Path $DataDir ('xfer-' + $Name + '.txt')
[IO.File]::WriteAllText($StatusF, ('params: Hub=[' + $Hub + '] Aid=[' + $Aid + '] Token=[' + $Token + '] Name=[' + $Name + '] Path=[' + $Path + '] DataDir=[' + $DataDir + ']'), [Text.Encoding]::ASCII)
$fs = $null
try {
    if ($Mode -eq 'up') {
        $fs = [IO.File]::OpenRead($Path)
        $seq = 1
        while ($true) {
            $buf = New-Object byte[] 262144
            $n = $fs.Read($buf, 0, 262144)
            if ($n -le 0) { break }
            $slice = New-Object byte[] $n
            [Array]::Copy($buf, 0, $slice, 0, $n)
            $posted = $false
            for ($att = 1; $att -le 3 -and -not $posted; $att++) {
                try {
                    $u1 = $Hub + '/filechunk?id=' + $Aid + '&token=' + $Token + '&name=' + $Name + '&seq=' + $seq
                    [IO.File]::AppendAllText($StatusF, [Environment]::NewLine + 'POST ' + $u1, [Text.Encoding]::ASCII)
                    $req = [System.Net.HttpWebRequest]::Create($u1)
                    $req.Method = 'POST'
                    $req.ContentType = 'application/octet-stream'
                    $req.Timeout = 180000
                    $req.ContentLength = $n
                    $rs = $req.GetRequestStream()
                    $rs.Write($slice, 0, $n)
                    $rs.Close()
                    $req.GetResponse().Close()
                    $posted = $true
                } catch {
                    if ($att -ge 3) { throw ('POST ' + $req.RequestUri + ' : ' + $_.Exception.Message) }
                    Start-Sleep -Seconds (5 * $att)
                }
            }
            $seq = $seq + 1
        }
        $fs.Close()
        $req = [System.Net.HttpWebRequest]::Create($Hub + '/filedone?id=' + $Aid + '&token=' + $Token + '&name=' + $Name + '&chunks=' + ($seq - 1))
        $req.Method = 'POST'
        $req.ContentType = 'application/json'
        $req.ContentLength = 2
        $rs = $req.GetRequestStream()
        $rs.Write([Text.Encoding]::ASCII.GetBytes('{}'), 0, 2)
        $rs.Close()
        $req.GetResponse().Close()
        [IO.File]::WriteAllText($StatusF, 'ok', [Text.Encoding]::ASCII)
    } else {
        $fs = [IO.File]::Create($Path)
        $seq = 1
        while ($true) {
            $u2 = $Hub + '/filechunk?id=' + $Aid + '&token=' + $Token + '&name=' + $Name + '&seq=' + $seq
            [IO.File]::AppendAllText($StatusF, [Environment]::NewLine + 'GET ' + $u2, [Text.Encoding]::ASCII)
            $req = [System.Net.HttpWebRequest]::Create($u2)
            $req.Method = 'GET'
            $req.Timeout = 180000
            try {
                $resp = $req.GetResponse()
            } catch {
                $code = 0
                if ($_.Exception -and $_.Exception.Response) { try { $code = [int]$_.Exception.Response.StatusCode } catch { } }
                if ($code -eq 404) { break }
                throw ('GET ' + $req.RequestUri + ' : ' + $_.Exception.Message)
            }
            $rs = $resp.GetResponseStream()
            $buf = New-Object byte[] 262144
            while (($n = $rs.Read($buf, 0, 262144)) -gt 0) { $fs.Write($buf, 0, $n) }
            $rs.Close()
            $resp.Close()
            $seq = $seq + 1
        }
        $fs.Close()
        [IO.File]::WriteAllText($StatusF, 'ok', [Text.Encoding]::ASCII)
    }
} catch {
    if ($fs) { try { $fs.Close() } catch { } }
    [IO.File]::AppendAllText($StatusF, [Environment]::NewLine + 'error: ' + $_.Exception.Message, [Text.Encoding]::ASCII)
}
'@
$xfer = $xfer.Replace('__HUB__', $hub).Replace('__AID__', $aid).Replace('__TOKEN__', $token).Replace('__DATADIR__', $dataDir)
[IO.File]::WriteAllText((Join-Path $dataDir 'filexfer.ps1'), $xfer, (New-Object Text.UTF8Encoding $false))
Write-Output 'file transfer worker ready'
    Write-Output 'agent installed (SYSTEM task, hidden, self-heals)'
    return
}

# ---- relay worker: outbound TCP spliced by the hub (web/RDP of this machine or its LAN) ----
if ($Relay) {
    $relayHost = $hub -replace '^http://', ''
    $relayHost = $relayHost.Substring(0, $relayHost.IndexOf(':'))
    $rSrv = New-Object System.Net.Sockets.TcpClient -ArgumentList @($relayHost, 80)
    $rNs = $rSrv.GetStream()
    $hs = [Text.Encoding]::ASCII.GetBytes(('B ' + $aid + ' ' + $token + ' ' + $Relay + [char]13 + [char]10))
    $rNs.Write($hs, 0, $hs.Length)
    $reply = ''
    $giveUp = [DateTime]::Now.AddSeconds(10)
    while ([DateTime]::Now -lt $giveUp -and $reply.IndexOf('OK') -lt 0 -and $reply.IndexOf('ERR') -lt 0) {
        if ($rNs.DataAvailable) {
            $rb = New-Object byte[] 256
            $rn = $rNs.Read($rb, 0, 256)
            $reply = $reply + [Text.Encoding]::ASCII.GetString($rb, 0, $rn)
        } else { Start-Sleep -Milliseconds 50 }
    }
    if ($reply.IndexOf('ERR') -lt 0 -and $reply.IndexOf('OK') -ge 0) {
        $tgt = New-Object System.Net.Sockets.TcpClient -ArgumentList @($RHost, ([int]$RPort))
        $tNs = $tgt.GetStream()
        $b1 = New-Object byte[] 65536
        $b2 = New-Object byte[] 65536
        $idle = 0
        while ($true) {
            $got = $false
            if ($rNs.DataAvailable) {
                $rn = $rNs.Read($b1, 0, $b1.Length)
                if ($rn -le 0) { break }
                $tNs.Write($b1, 0, $rn)
                $got = $true
            }
            if ($tNs.DataAvailable) {
                $tn = $tNs.Read($b2, 0, $b2.Length)
                if ($tn -le 0) { break }
                $rNs.Write($b2, 0, $tn)
                $got = $true
            }
            if ($got) { $idle = 0 } else { $idle += 40; if ($idle -gt 600000) { break }; Start-Sleep -Milliseconds 40 }
        }
        try { $tNs.Close(); $tgt.Close() } catch { }
    }
    try { $rNs.Close(); $rSrv.Close() } catch { }
    return
}

# ---- poll loop (task re-launches every minute; duplicate instance guarded by mutex) ----
$pollUrl = $hub + '/poll?id=' + $aid + '&token=' + $token
$hbUrl = $hub + '/heartbeat?id=' + $aid + '&token=' + $token
$resUrl = $hub + '/result?id=' + $aid + '&token=' + $token
$calUrl = $hub + '/info?id=' + $aid + '&token=' + $token
$calFile = Join-Path $dataDir 'c-aliases.txt'
$script:lastCal = ''
# mutex: prevent duplicate instances (schtasks re-launches every minute; PS2.0-safe New-Object)
$bs = [string][char]92
$mutexName = 'Global' + $bs + 'tailpet-agent-v2-' + $aid
$mutex = New-Object System.Threading.Mutex -ArgumentList @($false, $mutexName)
$got = $false
try { $got = $mutex.WaitOne(0) } catch { $got = $true }  # abandoned mutex = previous instance died
if (-not $got) { return }
$spool = Join-Path $dataDir 'spool'
if (-not (Test-Path $spool)) { New-Item -ItemType Directory -Force -Path $spool | Out-Null }
$pubkey = ''
$keyPub = Join-Path (Join-Path $dataDir 'keys') 'id_ed25519.pub'
if (Test-Path $keyPub) { $pubkey = [IO.File]::ReadAllText($keyPub).Trim() }
while ($true) {
    try {
    # poll returns plain base64 text (PS2.0-compatible, no JSON parsing)
    $b64 = HttpReq 'GET' $pollUrl ''
    $b64 = "$b64".Trim()
    if ($b64 -match '^[A-Za-z0-9+/=]+$') {
        $c = ''
        try { $c = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($b64)) } catch { }
        if ($c) {
            # 内部指令行（__relay/__fileup/__filedn/__timeout）不进 cmd，其余为 exec 命令
            $metaLines = @($c -split "`r?`n" | Where-Object { $_ -match '^__' })
            $execText = ((($c -split "`r?`n") | Where-Object { $_ -notmatch '^__' }) -join "`n").Trim()
            $maxWait = 120000
            foreach ($ml in $metaLines) {
                if ($ml -match '^__relay ') {
                    $pp = @($ml -split ' ')
                    if ($pp.Count -ge 4) {
                        Start-Process powershell -ArgumentList @('-NoProfile', '-ExecutionPolicy', 'Bypass', '-File', $selfPath, '-Relay', $pp[1], $pp[2], $pp[3]) -WindowStyle Hidden
                    }
                } elseif ($ml -match '^__(fileup|filedn) ') {
                    $sp = @($ml -split ' ', 3)
                    if ($sp.Count -ge 3) {
                        $xmode = $sp[0].Substring(2)
                        $xname = $sp[1]
                        $xpath = $sp[2]
                        $wcmd = '& "' + (Join-Path $dataDir 'filexfer.ps1') + '" -Hub ' + $hub + ' -Aid ' + $aid + ' -Token ' + $token + ' -Mode ' + $xmode + ' -Name ' + $xname + ' -Path "' + $xpath + '" -DataDir "' + $dataDir + '"'
                        $enc = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($wcmd))
                        [IO.File]::WriteAllText((Join-Path $dataDir 'spawn-dbg.txt'), ('WCMD: ' + $wcmd + [Environment]::NewLine + 'ENC: ' + $enc), [Text.Encoding]::Unicode)
                        Start-Process powershell -ArgumentList @('-NoProfile', '-EncodedCommand', $enc) -WindowStyle Hidden
                    }
                } elseif ($ml -match '^__timeout ') {
                    $tp = @($ml -split ' ')
                    if ($tp.Count -ge 2 -and $tp[1] -match '^\d+$') { $maxWait = [int]$tp[1] * 1000 }
                }
            }
            $c = $execText
        }
        if ($c) {
            $outF = Join-Path $env:TEMP ('tp-out-' + $pid + '.txt')
            $errF = Join-Path $env:TEMP ('tp-err-' + $pid + '.txt')
            # run via a temp bat so redirection covers the WHOLE command (&&, pipes, parens)
            $cmdF = Join-Path $env:TEMP ('tp-cmd-' + $pid + '.cmd')
            $pathLine = ''
            if (Test-Path (Join-Path (Join-Path $dataDir 'OpenSSH-Win64') 'ssh.exe')) {
                $pathLine = ('set "PATH=' + (Join-Path $dataDir 'OpenSSH-Win64') + ';' + $dataDir + ';%PATH%"') + [Environment]::NewLine
            }
            # 退出码写独立文件：外层 > outF 的句柄会锁住 bat 内的 >> outF（共享冲突）
            $exitF = Join-Path $env:TEMP ('tp-exit-' + $pid + '.txt')
            # 命令放子 cmd 执行（bat 调 bat 会转移控制、跳过标记行）；/V:ON 延迟展开让 !ERRORLEVEL! 在命令结束后才求值
            [IO.File]::WriteAllText($cmdF, '@echo off' + [Environment]::NewLine + $pathLine + ('cmd /V:ON /c "' + $c + ' & echo __TP_EXIT_!ERRORLEVEL!__> ' + $exitF + '"') + [Environment]::NewLine, [Text.Encoding]::Default)
            # doubled outer quotes: cmd /c strips first+last, leaving every inner quote intact
            $p = Start-Process cmd.exe -ArgumentList ('/c ""' + $cmdF + '" > "' + $outF + '" 2> "' + $errF + '""') -WindowStyle Hidden -PassThru
            $waited = 0
            while ($p.HasExited -eq $false -and $waited -lt $maxWait) { Start-Sleep -Milliseconds 500; $waited = $waited + 500 }
            $code = 124
            $so = ''
            $se = ''
            if ($p.HasExited -eq $false) {
                # 硬超时：卡死的命令杀进程树，绝不冻死 agent
                Start-Process taskkill.exe -ArgumentList @('/F', '/T', '/PID', [string]$p.Id) -WindowStyle Hidden
                $se = ('exec timeout (' + [int]($maxWait / 1000) + 's), process tree killed')
            } else {
                # PS2.0 下非 -Wait 进程的 ExitCode 取不到（null 会产生非法 JSON 被 hub 静默拒收）——退出码从独立标记文件解析
                if (Test-Path $outF) { $so = [IO.File]::ReadAllText($outF, [Text.Encoding]::Default) }
                if (Test-Path $errF) { $se = [IO.File]::ReadAllText($errF, [Text.Encoding]::Default) }
                if (Test-Path $exitF) {
                    $m = [Text.RegularExpressions.Regex]::Match([IO.File]::ReadAllText($exitF, [Text.Encoding]::Default), '__TP_EXIT_(\d+)__')
                    if ($m.Success) { $code = [int]$m.Groups[1].Value }
                }
                try { if ($p.ExitCode -ne $null) { $code = $p.ExitCode } } catch { }
            }
            Remove-Item $cmdF -ErrorAction SilentlyContinue
            Remove-Item $outF, $errF, $exitF -ErrorAction SilentlyContinue
            $body = '{"exit":' + $code + ',"stdout":' + (JsonStr $so) + ',"stderr":' + (JsonStr $se) + '}'
            HttpReq 'POST' $resUrl $body
        }
    }
    # upload c-aliases when changed (hub /info -> A's sync-alias reads it)
    if (Test-Path $calFile) {
        $cur = [IO.File]::ReadAllText($calFile)
        if ($cur -ne $script:lastCal) {
            $body = '{"caliases":' + (JsonStr $cur) + '}'
            HttpReq 'POST' $calUrl $body
            $script:lastCal = $cur
        }
    }
    HttpReq 'POST' $hbUrl ('{"name":' + (JsonStr $name) + ',"pubkey":' + (JsonStr $pubkey) + '}')
    } catch {
        # agent-side errors land in hub info.json (readable on S) - never vanish silently
        try { HttpReq 'POST' $calUrl ('{"agentErr":' + (JsonStr ("poll-loop: " + $_.Exception.Message)) + '}') } catch { }
    }
    Start-Sleep 3
}
