# headscale 配置模板 — {{DOMAIN}} / 控制端口 {{CONTROL_PORT}}
# 渲染时替换 {{DOMAIN}}、{{CONTROL_PORT}}；证书路径固定指向 /mnt/c/headscale-certs
server_url: https://{{DOMAIN}}:{{CONTROL_PORT}}
listen_addr: 0.0.0.0:443
metrics_listen_addr: 127.0.0.1:9090
grpc_listen_addr: 127.0.0.1:50443

tls_cert_path: /mnt/c/headscale-certs/certificates/{{DOMAIN}}.crt
tls_key_path: /mnt/c/headscale-certs/certificates/{{DOMAIN}}.key

noise:
  private_key_path: /var/lib/headscale/noise_private.key

prefixes:
  v4: 100.64.0.0/10

database:
  type: sqlite
  sqlite:
    path: /var/lib/headscale/db.sqlite

dns:
  magic_dns: false
  override_local_dns: false
  base_domain: zg.internal

derp:
  urls:
    - https://controlplane.tailscale.com/derpmap/default
  server:
    enabled: true
    region_id: 999
    region_code: hs-s1
    region_name: "S 内嵌中继"
    stun_listen_addr: "0.0.0.0:3478"
    private_key_path: /var/lib/headscale/derp_server_private.key
    automatically_add_embedded_derp_region: true
    ipv4: {{SERVER_IP}}

log:
  format: text
  level: info
